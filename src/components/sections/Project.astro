const splitText = (text: string) => {
  return text.split("").map((char) => (char === " " ? "\u00A0" : char));
};

const introChars = splitText(
  "Sanora is my creative engineering practice, where frontend development, visual design, interaction, and motion come together to create digital experiences that feel as good as they work."
);
const titleChars = splitText("Project");
---

<section id="project-container" class="project-container flex flex-col w-full max-w-360 h-max px-6 sm:px-10 py-16 sm:py-24 bg-sanora-neutral-50 text-sanora-blue-950 font-geist mx-auto gap-12 sm:gap-20">
  <p class="project-intro font-normal text-2xl sm:text-[32px] text-justify leading-snug inline-flex flex-wrap overflow-hidden">
    {introChars.map((char) => (
      <span class="char inline-block opacity-0 blur-[10px] translate-y-6">{char}</span>
    ))}
  </p>

  <div class="flex flex-col gap-7">
    <h1 class="project-title font-newsreader text-project-large italic inline-flex overflow-hidden">
      {titleChars.map((char) => (
        <span class="char inline-block opacity-0 blur-[12px] translate-y-8">{char}</span>
      ))}
    </h1>

    <div class="projects font-geist w-full">
      <!-- Table Header -->
      <div class="projects-head border-b-[1.5px] border-sanora-blue-900 uppercase pb-2 text-[.6875rem]" aria-hidden="true">
        <span>Name</span>
        <span class="hidden md:inline-block">Category</span>
        <span class="hidden md:inline-block">Client</span>
        <span class="projects__year">Year</span>
      </div>

      <!-- Projects Dynamic Loop -->
      {projectsData.map((item, index) => (
        <article class="project text-[.9375rem] relative" data-project-index={index}>
          <button
            type="button"
            aria-controls={item.id}
            class="project-row relative grid w-full text-left cursor-pointer isolate border-0 overflow-hidden select-none"
            aria-expanded="false"
          >
            <!-- Hover Background Fill Layer -->
            <span class="project-bg z-0 bg-sanora-blue-950 absolute" aria-hidden="true"></span>

            <!-- Table Cells -->
            <span class="project-cell isolate z-1 block relative overflow-hidden" style="--i: 0">
              <span class="project-text block font-medium">{item.name}</span>
            </span>
            <span class="project-cell projects-col--wide isolate z-1 hidden md:block relative overflow-hidden" style="--i: 1">
              <span class="project-text block">{item.category}</span>
            </span>
            <span class="project-cell projects-col--wide isolate z-1 hidden md:block relative overflow-hidden" style="--i: 2">
              <span class="project-text block">{item.client}</span>
            </span>
            <span class="project-cell projects-year isolate z-1 block relative overflow-hidden" style="--i: 3">
              <span class="project-text block text-right font-mono">{item.year}</span>
            </span>
          </button>

          <!-- Accordion Collapsible Body -->
          <div class="project-body grid" inert id={item.id}>
            <div class="project-inner min-h-0 overflow-hidden">
              <p class="project-desc max-w-[32em] pt-[1em]">
                {item.description}
              </p>
              {item.url !== "none" ? (
                <a
                  class="project-link mt-[1rem] text-[.9375rem] inline-block font-medium hover:text-sanora-blue-700 transition-colors"
                  href={item.url}
                  target="_blank"
                  rel="noopener"
                >
                  See website
                </a>
              ) : null}
              <div class="project-images grid pt-8 pb-6 gap-4 grid-cols-1 sm:grid-cols-2 md:grid-cols-3">
                {item.images.map((imgSrc, imgIdx) => (
                  <div class="overflow-hidden rounded-lg bg-sanora-blue-950/10 aspect-video group">
                    <img
                      src={imgSrc}
                      alt={`${item.name} screenshot ${imgIdx + 1}`}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("project-container");
    if (!section) return;

    ScrollTrigger.refresh();

    // 1. Heading & Intro Character-by-Character Reveal Timeline (Play Once)
    const textTl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 75%",
        once: true,
      },
    });

    textTl
      .to(".project-intro .char", {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        duration: 0.8,
        stagger: 0.005,
        ease: "power3.out",
      })
      .to(
        ".project-title .char",
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 1,
          stagger: 0.04,
          ease: "power3.out",
        },
        "-=0.4"
      );

    // 2. Project Rows Scroll Entrance (Triggers Only Once)
    const projectArticles = section.querySelectorAll<HTMLElement>(".project");

    projectArticles.forEach((article, idx) => {
      ScrollTrigger.create({
        trigger: article,
        start: "top 88%",
        once: true,
        onEnter: () => {
          gsap.delayedCall(idx * 0.08, () => {
            article.classList.add("is-in");
          });
        },
      });

      // 3. Directional Hover Fill Animation
      const btn = article.querySelector<HTMLButtonElement>(".project-row");
      if (!btn) return;

      btn.addEventListener("mouseenter", (e) => {
        const rect = btn.getBoundingClientRect();
        const isTop = e.clientY - rect.top < rect.height / 2;

        btn.classList.remove("is-leaving", "is-from-top", "is-from-bottom");
        btn.classList.add(isTop ? "is-from-top" : "is-from-bottom");

        void btn.offsetWidth;
        btn.classList.add("is-hovering");
      });

      btn.addEventListener("mouseleave", (e) => {
        const rect = btn.getBoundingClientRect();
        const isTop = e.clientY - rect.top < rect.height / 2;

        btn.classList.remove("is-hovering");
        btn.classList.add("is-leaving");

        if (isTop) {
          btn.classList.add("is-from-top");
          btn.classList.remove("is-from-bottom");
        } else {
          btn.classList.add("is-from-bottom");
          btn.classList.remove("is-from-top");
        }
      });

      // 4. Accordion Toggle
      btn.addEventListener("click", () => {
        const isOpen = article.classList.contains("is-open");

        projectArticles.forEach((other) => {
          if (other !== article && other.classList.contains("is-open")) {
            other.classList.remove("is-open");
            const otherBtn = other.querySelector<HTMLButtonElement>(".project-row");
            const otherBody = other.querySelector<HTMLElement>(".project-body");
            if (otherBtn) otherBtn.setAttribute("aria-expanded", "false");
            if (otherBody) otherBody.setAttribute("inert", "");
          }
        });

        const body = article.querySelector<HTMLElement>(".project-body");
        if (isOpen) {
          article.classList.remove("is-open");
          btn.setAttribute("aria-expanded", "false");
          if (body) body.setAttribute("inert", "");
        } else {
          article.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
          if (body) body.removeAttribute("inert");
        }

        setTimeout(() => ScrollTrigger.refresh(), 500);
      });
    });
  });
</script>
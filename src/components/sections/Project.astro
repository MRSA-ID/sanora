const splitText = (text: string) => {
  return text.split("").map((char) => (char === " " ? "\u00A0" : char));
};

const introChars = splitText(
  "Sanora is my creative engineering practice, where frontend development, visual design, interaction, and motion come together to create digital experiences that feel as good as they work."
);
const titleChars = splitText("Project");
---

<section id="project-container" class="project-container">
  <p class="project-intro">
    {introChars.map((char) => (
      <span class="char inline-block opacity-0 blur-[10px] translate-y-6">{char}</span>
    ))}
  </p>

  <div class="flex flex-col gap-7">
    <h1 class="project-title">
      {titleChars.map((char) => (
        <span class="char inline-block opacity-0 blur-[12px] translate-y-8">{char}</span>
      ))}
    </h1>

    <div class="projects">
      <!-- Table Header -->
      <div class="projects-head" aria-hidden="true">
        <span>Name</span>
        <span class="hidden md:inline-block">Category</span>
        <span class="hidden md:inline-block">Client</span>
        <span class="projects__year">Year</span>
      </div>

      <!-- Projects Dynamic Loop -->
      {projectsData.map((item, index) => (
        <article class="project" data-project-index={index}>
          <button
            type="button"
            aria-controls={item.id}
            class="project-row"
            aria-expanded="false"
          >
            <!-- Hover Background Fill Layer -->
            <span class="project-bg" aria-hidden="true"></span>

            <!-- Table Cells -->
            <span class="project-cell block" style="--i: 0">
              <span class="project-text block font-medium">{item.name}</span>
            </span>
            <span class="project-cell projects-col--wide hidden md:block" style="--i: 1">
              <span class="project-text block">{item.category}</span>
            </span>
            <span class="project-cell projects-col--wide hidden md:block" style="--i: 2">
              <span class="project-text block">{item.client}</span>
            </span>
            <span class="project-cell projects-year block" style="--i: 3">
              <span class="project-text block text-right font-mono">{item.year}</span>
            </span>
          </button>

          <!-- Accordion Collapsible Body -->
          <div class="project-body grid" inert id={item.id}>
            <div class="project-inner">
              <p class="project-desc">
                {item.description}
              </p>
              {item.url !== "none" ? (
                <a
                  class="project-link"
                  href={item.url}
                  target="_blank"
                  rel="noopener"
                >
                  See website
                </a>
              ) : null}
              <div class="project-images">
                {item.images.map((imgObj, imgIdx) => (
                  <div class="group">
                    <Image
                      src={imgObj}
                      alt={`${item.name} screenshot ${imgIdx + 1}`}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("project-container");
    if (!section) return;

    ScrollTrigger.refresh();

    const projectArticles = section.querySelectorAll<HTMLElement>(".project");

    // 1. Heading, Intro & Table Header Reveal Timeline (Play Once)
    const textTl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 70%",
        once: true,
      },
      onComplete: () => {
        // 2. Trigger Project Rows Entrance after header reveal completes
        projectArticles.forEach((article, idx) => {
          gsap.delayedCall(idx * 0.08, () => {
            article.classList.add("is-in");
          });
        });
      },
    });

    textTl
      .to(".project-intro .char", {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        duration: 0.8,
        stagger: 0.005,
        ease: "power3.out",
      })
      .to(
        ".project-title .char",
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 1,
          stagger: 0.04,
          ease: "power3.out",
        },
        "-=0.4"
      )
      .to(
        ".projects-head",
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 0.8,
          ease: "power3.out",
        },
        "-=0.3"
      );

    // Setup Row Interactions (Hover & Accordion)
    projectArticles.forEach((article) => {
      // Directional Hover Fill Animation
      const btn = article.querySelector<HTMLButtonElement>(".project-row");
      if (!btn) return;

      btn.addEventListener("mouseenter", (e) => {
        const rect = btn.getBoundingClientRect();
        const isTop = e.clientY - rect.top < rect.height / 2;

        btn.classList.remove("is-leaving", "is-from-top", "is-from-bottom");
        btn.classList.add(isTop ? "is-from-top" : "is-from-bottom");

        void btn.offsetWidth;
        btn.classList.add("is-hovering");
      });

      btn.addEventListener("mouseleave", (e) => {
        const rect = btn.getBoundingClientRect();
        const isTop = e.clientY - rect.top < rect.height / 2;

        btn.classList.remove("is-hovering");
        btn.classList.add("is-leaving");

        if (isTop) {
          btn.classList.add("is-from-top");
          btn.classList.remove("is-from-bottom");
        } else {
          btn.classList.add("is-from-bottom");
          btn.classList.remove("is-from-top");
        }
      });

      // Accordion Toggle
      btn.addEventListener("click", () => {
        const isOpen = article.classList.contains("is-open");

        projectArticles.forEach((other) => {
          if (other !== article && other.classList.contains("is-open")) {
            other.classList.remove("is-open");
            const otherBtn = other.querySelector<HTMLButtonElement>(".project-row");
            const otherBody = other.querySelector<HTMLElement>(".project-body");
            if (otherBtn) otherBtn.setAttribute("aria-expanded", "false");
            if (otherBody) otherBody.setAttribute("inert", "");
          }
        });

        const body = article.querySelector<HTMLElement>(".project-body");
        if (isOpen) {
          article.classList.remove("is-open");
          btn.setAttribute("aria-expanded", "false");
          if (body) body.setAttribute("inert", "");
        } else {
          article.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
          if (body) body.removeAttribute("inert");
        }

        setTimeout(() => ScrollTrigger.refresh(), 500);
      });
    });
  });
</script>
---
import GreenEye from "@assets/gif/green_eye.gif"
import YellowEye from "@assets/gif/yellow-eye.gif"
import RedEye from "@assets/gif/red-eye.gif"
import GreenEyeOld from "@assets/gif/green-old-eye.gif"
import BlackEye from "@assets/gif/black-eye.gif"
import BlueEye from "@assets/gif/blue-eye.gif"

const testimonials = [
  {
    quote: "Fast learner and can quickly adapt to our system and especially our company works in the maps application.",
    author: "Ahmad Rayis, Circlegeo",
    gif: GreenEye,
    bgColor: "#6fd955",
    imageClass: "object-[50%_80%]"
  },
  {
    quote: "A full-stack web developer with strong UI/UX instincts, skilled at turning complex requirements into clean, high-performing web solutions.",
    author: "Gema Aditya Mahendra, Exalter Students",
    gif: YellowEye,
    bgColor: "#f5b82e",
    imageClass: "object-[50%_80%]"
  },
  {
    quote: "Great work, clean code and good personality",
    author: "Lulu Maulana Malik, Circlegeo",
    gif: RedEye,
    bgColor: "#f8563f",
    imageClass: "object-[50%_75%]"
  },
  {
    quote: "Can work with challenges, proven that the tasks he takes are always heavy tasks.",
    author: "Naufal Yukafi Ridlo, Freelance",
    gif: GreenEyeOld,
    bgColor: "#26694e",
    imageClass: "object-[50%_80%]"
  },
  {
    quote: "An exceptional front-end developer and collaborative problem-solver who consistently delivers creative solutions in team pairing.",
    author: "Aldycky Bagus Widjaksana, SUPERSPRING",
    gif: BlackEye,
    bgColor: "#0a0b0d",
    imageClass: "scale-150 origin-[50%_80%]"
  },
  {
    quote: "A skilled front-end developer who transforms UI/UX designs into high-performing web apps, driving seamless user experiences and faster product delivery.",
    author: "Ageng Permadi, EBP",
    gif: BlueEye,
    bgColor: "#5c86f8",
    imageClass: "scale-150 origin-[50%_80%]"
  }
];
---

<section id="testimoni-container" class="testimoni-container">
  <div class="testimonial">
    <div id="testimoni-header" class="testimoni-header">
      <div class="w-full">
        <h1>What They Said</h1>
        <p class="text-testi-desc">Feedback from the founders, teams, and brands I've collaborated with.</p>
      </div>
      <span>Sanora</span>
    </div>
    
    <!-- content marquee testi with side gradient masks -->
    <div id="testimoni-marquee-wrapper" class="testimonial-wrapper-marquee">
      <div class="marquee-track animate-marquee">
        <!-- First set of testimonials -->
        {testimonials.map((item) => (
          <div 
            class="testimoni-card"
            style={`background-color: ${item.bgColor};`}
          >
            <div class="testimoni-wrapper-img">
              <img 
                src={item.gif.src} 
                width={item.gif.width} 
                height={item.gif.height} 
                alt={item.author} 
                class={`block aspect-square object-cover ${item.imageClass}`}
              />
            </div>
            
            <div class="testimoni-desc-container">
              <div 
                class="testimoni-desc-wrapper"
                style={`background: linear-gradient(to top, ${item.bgColor} 80%, transparent 100%);`}
              >
                <div class="testimoni-quote-wrapper">
                  <p>
                    <span>&ldquo;</span>
                    {item.quote}
                  </p>
                </div>
                <div class="testimoni-author-wrapper">
                  <hr />
                  <span >{item.author}</span>
                </div>
              </div>
            </div>
          </div>
        ))}

        <!-- Duplicated set for seamless loop -->
        {testimonials.map((item) => (
          <div 
            class="testimoni-card"
            aria-hidden="true"
            style={`background-color: ${item.bgColor};`}
          >
            <div class="testimoni-wrapper-img">
              <img 
                src={item.gif.src} 
                width={item.gif.width} 
                height={item.gif.height} 
                alt=""
                class={`block aspect-square object-cover ${item.imageClass}`}
              />
            </div>
            
            <div class="testimoni-desc-container">
              <div 
                class="testimoni-desc-wrapper"
                style={`background: linear-gradient(to top, ${item.bgColor} 80%, transparent 100%);`}
              >
                <div class="testimoni-quote-wrapper">
                  <p>
                    <span>&ldquo;</span>
                    {item.quote}
                  </p>
                </div>
                <div class="testimoni-author-wrapper">
                  <hr/>
                  <span>{item.author}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("testimoni-container");
    const header = document.getElementById("testimoni-header");
    const marqueeWrapper = document.getElementById("testimoni-marquee-wrapper");

    if (section && header && marqueeWrapper) {
      // 1. Smooth Upper Curtain Overlap over pinned Contribute section
      gsap.fromTo(
        section,
        { yPercent: 0 },
        {
          yPercent: 0,
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "top bottom",
            end: "top top",
            scrub: true,
            onRefresh: () => ScrollTrigger.update(),
          },
        }
      );

      // 2. Header Reveal
      gsap.fromTo(
        header,
        {
          y: 50,
          opacity: 0,
          filter: "blur(10px)"
        },
        {
          y: 0,
          opacity: 1,
          filter: "blur(0px)",
          duration: 1.2,
          ease: "power3.out",
          scrollTrigger: {
            trigger: section,
            start: "top 60%",
            toggleActions: "play none none reverse",
          }
        }
      );

      // 3. Marquee Wrapper Reveal
      gsap.fromTo(
        marqueeWrapper,
        {
          y: 60,
          scale: 0.96,
          opacity: 0,
          filter: "blur(14px)"
        },
        {
          y: 0,
          scale: 1,
          opacity: 1,
          filter: "blur(0px)",
          duration: 1.4,
          delay: 0.15,
          ease: "power3.out",
          scrollTrigger: {
            trigger: section,
            start: "top 50%",
            toggleActions: "play none none reverse",
          }
        }
      );
    }
  });
</script>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 40s linear infinite;
  }
</style>
---
// src/components/sections/About.astro
import { Image } from "astro:assets";
import RadialGlow from "@components/RadialGlow.astro";
import CV from "@assets/Software Engineer CV.pdf";
import { logos } from "@/data/logos";

const splitText = (text: string) => {
  return text.split("").map((char) => (char === " " ? "\u00A0" : char));
};

const line1Chars = splitText("Building thoughtful");
const line2Chars = splitText("digital experiences.");
const identityChars = splitText("01 / IDENTITY");
const buttonChars = splitText("About me");
---

<section
  id="about-container"
  class="about-container"
>
  <!-- Background Radial Glows -->
  <div class="glow-layer-left parallax-glow" data-parallax-speed="-80">
    <RadialGlow size={1500} variant="left" />
  </div>

  <div class="glow-layer-right parallax-glow" data-parallax-speed="80">
    <RadialGlow
      size={1500}
      reversed={true}
      radialStops="circle at 60% 10%, #2388FF 36%, #E9F3FF 61%"
      variant="right"
    />
  </div>

  <!-- Glassmorphic Layer -->
  <div class="glassmorphic-container">
    <!-- Inner Content Wrapper -->
    <div class="about-content-inner">
      <div class="about-content-headline ">
        <!-- 01 / IDENTITY Label -->
        <span class="reveal-identity about-label">
          {identityChars.map((char) => (
            <span class="char inline-block opacity-0 blur-[10px] translate-y-4">{char}</span>
          ))}
        </span>

        <h1 class="about-headline">
          <!-- Headline Line 1 -->
          <p class="reveal-line1 inline-flex overflow-hidden">
            {line1Chars.map((char) => (
              <span class="char inline-block opacity-0 blur-md translate-y-8">{char}</span>
            ))}
          </p>

          <!-- Headline Line 2 -->
          <p class="reveal-line2 inline-flex overflow-hidden">
            {line2Chars.map((char) => (
              <span class="char inline-block opacity-0 blur-md translate-y-8">{char}</span>
            ))}
          </p>
        </h1>
      </div>
      
      <!-- CV Download Button -->
      <a
        href={CV}
        download="Software Engineer CV.pdf"
        id="cv-download-btn"
        class="reveal-btn about-download-btn group"
      >
        <span class="flex justify-start items-center overflow-hidden">
          {buttonChars.map((char, i) => (
            <span
              class="inline-block overflow-hidden"
              style={{ height: "1.1em" }}
            >
              <span
                class="flex flex-col transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-1/2"
                style={{ transitionDelay: `${30 * i}ms` }}
              >
                <span class="block text-left" style={{ height: "1.1em", lineHeight: "1.1em" }}>
                  {char}
                </span>
                <span class="block text-left" style={{ height: "1.1em", lineHeight: "1.1em" }} aria-hidden="true">
                  {char}
                </span>
              </span>
            </span>
          ))}
        </span>
      </a>

      <!-- Logo Marquee Wrapper -->
      <div class="reveal-logos about-list-logo-container">
        <div class="marquee-track flex w-max gap-8 sm:gap-12 md:gap-16 items-center">
          <!-- Loop 1 -->
          <div class="flex gap-8 sm:gap-12 md:gap-16 items-center shrink-0">
            {logos.map((logo) => (
              <div class="flex items-center justify-center shrink-0 h-8 sm:h-10 md:h-12 opacity-80 hover:opacity-100 transition-opacity">
                <Image 
                  src={logo.src} 
                  alt={logo.name} 
                  loading="lazy" 
                  decoding="async" 
                  class="h-full w-auto object-contain" 
                />
              </div>
            ))}
          </div>
          <!-- Loop 2 (Duplicate for Seamless Loop) -->
          <div class="flex gap-8 sm:gap-12 md:gap-16 items-center shrink-0" aria-hidden="true">
            {logos.map((logo) => (
              <div class="flex items-center justify-center shrink-0 h-8 sm:h-10 md:h-12 opacity-80 hover:opacity-100 transition-opacity">
                <Image 
                  src={logo.src} 
                  alt="" 
                  loading="lazy" 
                  decoding="async" 
                  class="h-full w-auto object-contain" 
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Blur Gradient Overlay -->
  <div class="pointer-events-none absolute bottom-0 inset-x-0 h-32 z-20 bg-linear-to-b from-transparent via-sanora-blue-950/60 to-sanora-blue-950 backdrop-blur-sm mask-[linear-gradient(to_bottom,transparent_0%,black_100%)]"></div>

</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("about-container");
    if (!section) return;

    ScrollTrigger.refresh();

    // 1. Live Container Expansion (900px to 100%)
    gsap.fromTo(
      section,
      {
        width: "90%",
        maxWidth: "900px",
        borderRadius: "32px",
      },
      {
        width: "100%",
        maxWidth: "100%",
        borderRadius: "0px",
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top bottom",
          end: "top top",
          scrub: true,
          invalidateOnRefresh: true,
        },
      }
    );

    // 2. Content Reveal Scrub Timeline
    const scrubTl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 70%",
        end: "top 20%",
        scrub: true,
      },
    });

    scrubTl
      .to(".glow-layer-left, .glow-layer-right", {
        opacity: 1,
        scale: 1,
        filter: "blur(0px)",
        stagger: 0.1,
        ease: "none",
      }, 0)
      .to(".reveal-identity .char", {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        stagger: 0.02,
        ease: "none",
      }, 0.1)
      .to(".reveal-line1 .char", {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        stagger: 0.02,
        ease: "none",
      }, 0.25)
      .to(".reveal-line2 .char", {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        stagger: 0.02,
        ease: "none",
      }, 0.4)
      .to(".reveal-btn", {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        ease: "none",
      }, 0.6)
      .to(".reveal-logos", {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        ease: "none",
      }, 0.75);

    // 3. Upward Parallax Drift for Internal Content
    gsap.fromTo(
      ".about-content-inner",
      { y: 60 },
      {
        y: -80,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top bottom",
          end: "bottom top",
          scrub: true,
        },
      }
    );
  });
</script>

<style>
  @keyframes logoMarquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-track {
    animation: logoMarquee 22s linear infinite;
    will-change: transform;
  }
</style>
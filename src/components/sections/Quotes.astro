---
import { Image } from 'astro:assets';
import QuotesImage from '@assets/image/quote.jpg';
---

<section id="quotes-container" class="w-full mx-auto flex items-center justify-center max-w-360 min-h-175 h-full px-4 sm:px-10 py-9">
  <Image 
    src={QuotesImage} 
    alt="The next big thing will be a lot of small things quote background" 
    loading="lazy" 
    decoding="async" 
    class="max-h-[700px] h-full object-cover" 
  />
</section>
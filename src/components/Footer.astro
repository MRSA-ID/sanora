---
import { ArrowUp } from '@lucide/astro';
import HalftoneWordmark from '@components/ui/halftone-wordmark'

const footerContent = [
 {
  title: "Location",
  item: [
   {
    title: "Bekasi, Jawa Barat Indonesia",
    link: null
   }
  ]
 },
 {
  title: "Sitemap",
  item: [
   {
    title: "Home",
    link: "#home"
   },
   {
    title: "About",
    link: "#about"
   },
   {
    title: "Project",
    link: "#project"
   },
   {
    title: "Services",
    link: "#services"
   },
   {
    title: "Testimonial",
    link: "#testimonial"
   },
  ]
 },
 {
  title: "Socials",
  item: [
   {
    title: "Instagram",
    link: "https://www.instagram.com/snr66._/"
   },
   {
    title: "Dribble",
    link: "https://dribbble.com/MRSA-DR"
   },
   {
    title: "Github",
    link: "https://github.com/MRSA-ID"
   },
   {
    title: "Linkedin",
    link: "https://www.linkedin.com/in/ramadhansa/"
   },
   {
    title: "Youtube",
    link: "https://www.youtube.com/@JEE_ZEEN"
   },
  ]
 },
]
---

<footer class="flex flex-col w-full min-h-screen h-full font-geist text-sanora-blue-950 justify-center sm:justify-start px-4 sm:px-10 pt-6 pb-11 gap-10 overflow-hidden relative">
 <!-- marquee text -->
 <div class="footer-marquee-wrapper relative w-full overflow-hidden mask-[linear-gradient(to_right,transparent_0%,black_2.5%,black_97.5%,transparent_100%)] select-none">
  <div class="footer-marquee-track flex w-max animate-footer-marquee hover:[animation-play-state:paused] whitespace-nowrap">
   <!-- First Track -->
   <div class="flex items-center gap-8 pr-8">
    <span class="font-montreal text-footer-large font-normal leading-none">/ Get in touch</span>
    <span class="font-montreal text-footer-large font-normal leading-none">/ Get in touch</span>
    <span class="font-montreal text-footer-large font-normal leading-none">/ Get in touch</span>
   </div>
   <!-- Duplicate Track for Seamless Loop -->
   <div class="flex items-center gap-8 pr-8" aria-hidden="true">
    <span class="font-montreal text-footer-large font-normal leading-none">/ Get in touch</span>
    <span class="font-montreal text-footer-large font-normal leading-none">/ Get in touch</span>
    <span class="font-montreal text-footer-large font-normal leading-none">/ Get in touch</span>
   </div>
  </div>
 </div>
 
 <div class="flex flex-col gap-25">
  <div class="grid grid-cols-2 md:grid-cols-[minmax(0,463px)_1fr_1fr_1fr_auto] gap-x-12.75 gap-y-6">
   <h2 class="w-full col-span-2 md:col-span-1 max-w-116 text-footer-title-large font-medium leading-[100%]">The next good thing starts here</h2>
   {
    footerContent.map((content,i)=>(
    <div class="w-full text-footer-extra-small">
     <h2 class="font-bold pb-6">{content.title}</h2>
     <div class="list-none space-y-4">
      {content.item.map((list,index)=>(
       list.link === null ? 
       <li class="opacity-80">{list.title}</li>
       :
       <li class="w-max">
         <a 
           href={list.link} 
           class="relative inline-block transition-transform duration-300 hover:translate-x-1 after:absolute after:bottom-0 after:left-0 after:h-[1px] after:w-0 hover:after:w-full after:bg-sanora-blue-950 after:transition-all after:duration-300"
         >
           {list.title}
         </a>
        </li>
      ))}
     </div>
    </div>
    ))
   }
   <button 
    id="scroll-to-top"
    aria-label="Back to top"
    class="group button-to-top row-start-2 col-start-2 md:row-start-1 md:col-start-5 w-max h-full flex items-center justify-center place-self-end-safe md:place-self-start max-h-20 border! border-sanora-blue-950! px-4 py-6 rounded-4xl cursor-pointer transition-all duration-300 ease-out hover:-translate-y-1 active:scale-95"
   >
    <ArrowUp class='size-6 group-hover:animate-bounce transition-transform duration-300' />
   </button>
  </div>
  <div class="w-full flex flex-col sm:flex-row justify-between text-footer-extra-small">
   <div class="flex gap-1">
    <p class="font-medium"><span>©</span>SNR 2026 <span>sanggisda@gmail.com</span></p>
   </div>
   <span>DESIGNED WITH INTENTION.</span>
  </div>

  <!-- Halftone Canvas Wordmark Section -->
  <div class="w-full absolute bottom-0 left-0">
   <HalftoneWordmark 
     wordmark="SANORA" 
     background="#fafaf8" 
     ink="#0129b0" 
     warm="#78A1FF" 
     height="clamp(120px, calc(37.143px + 19.643vw), 320px)"
     client:visible 
   />
  </div>

  <!-- <div 
    class="absolute inset-0 translate-y-[50%] pointer-events-none z-1"
    style="background: radial-gradient(120% 100% at 50% -30%, transparent 45%, #c4d8ff 65%, #0129b0 95%); filter: blur(24px); opacity: 0.85;"
  ></div> -->

  <!-- High Contrast Radial Gradient Edge Overlay -->
  <!-- <div 
    class="absolute inset-0 translate-y-[50%] pointer-events-none z-2 mix-blend-multiply"
    style="background: radial-gradient(110% 85% at 50% -20%, transparent 50%, #0129b0 90%);"
  ></div> -->
 </div>
</footer>

<script>
  const scrollBtn = document.getElementById('scroll-to-top');
  scrollBtn?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>

<style>
  @keyframes footer-marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-footer-marquee {
    animation: footer-marquee 25s linear infinite;
  }
</style>
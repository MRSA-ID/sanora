---
import { ArrowUp } from '@lucide/astro';
import HalftoneWordmark from '@components/ui/halftone-wordmark';
import { footerContent } from '@/data/footer';
---

<footer id="footer-reveal" class="footer-container">
 <!-- marquee text -->
 <div class="footer-marquee-wrapper">
  <div id="footer-marquee-track" class="footer-marquee-track">
   <!-- First Track -->
   <div>
    <span>/ Get in touch</span>
    <span>/ Get in touch</span>
    <span>/ Get in touch</span>
   </div>
   <!-- Duplicate Track for Seamless Loop -->
   <div aria-hidden="true">
    <span>/ Get in touch</span>
    <span>/ Get in touch</span>
    <span>/ Get in touch</span>
   </div>
  </div>
 </div>
 
 <div class="footer-content-container">
  <div class="footer-content-wrapper">
   <h2>The next good thing starts here</h2>
   {
    footerContent.map((content) => (
    <div class="footer-content">
     <h2>{content.title}</h2>
     <div class="footer-list">
      {content.item.map((list) => (
       list.link === null ? 
       <li class="opacity-80">{list.title}</li>
       :
       <li class="w-max">
         <a 
           href={list.link} 
           class="footer-nav-link"
         >
           {list.title}
         </a>
        </li>
      ))}
     </div>
    </div>
    ))
   }
   <button 
    id="scroll-to-top"
    aria-label="Back to top"
    class="group button-to-top"
   >
    <ArrowUp class='size-6 group-hover:animate-bounce transition-transform duration-300' />
   </button>
  </div>

  <div class="footer-copyright">
   <div>
    <p class="font-medium"><span>©</span>SNR 2026 <span>sanggisda@gmail.com</span></p>
   </div>
   <span>DESIGNED WITH INTENTION.</span>
  </div>

  <!-- Halftone Canvas Wordmark Section -->
  <div class="footer-wordmark-wrapper">
   <HalftoneWordmark 
     wordmark="SANORA" 
     background="#fafaf8" 
     ink="#0129b0" 
     warm="#78A1FF" 
     height="clamp(120px, calc(37.143px + 19.643vw), 320px)"
     client:visible 
   />
  </div>
 </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function smoothScrollTo(target: number | HTMLElement | string) {
    const lenis = (window as any).lenis;
    if (lenis) {
      lenis.scrollTo(target, { offset: 0, duration: 1.2 });
    } else {
      const el = typeof target === 'string' ? document.querySelector(target) : target;
      if (typeof target === 'number') {
        gsap.to(window, { duration: 1.2, scrollTo: 0, ease: "power3.inOut" });
      } else if (el) {
        gsap.to(window, { duration: 1.2, scrollTo: { y: el }, ease: "power3.inOut" });
      } else {
        window.scrollTo({ top: typeof target === 'number' ? target : 0, behavior: 'smooth' });
      }
    }
  }

  // 1. Scroll-to-Top Handler
  const scrollBtn = document.getElementById('scroll-to-top');
  scrollBtn?.addEventListener('click', () => {
    smoothScrollTo(0);
  });

  // 2. Footer Internal Navigation Links Handler
  document.querySelectorAll<HTMLAnchorElement>('.footer-nav-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        // Scroll to top (0) if link targets home or hero-container
        if (href === "#home" || href === "#hero-container") {
          e.preventDefault();
          smoothScrollTo(0);
        } else {
          const targetEl = document.querySelector(href);
          if (targetEl) {
            e.preventDefault();
            smoothScrollTo(targetEl as HTMLElement);
          }
        }
      }
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const footer = document.getElementById("footer-reveal");
    const marqueeTrack = document.getElementById("footer-marquee-track");

    // 3. Footer Curtain Reveal Animation
    if (footer) {
      const prevSection = footer.previousElementSibling;
      if (prevSection) {
        gsap.set(prevSection, { position: "relative", zIndex: 10 });
      }

      gsap.fromTo(
        footer,
        { yPercent: -35, opacity: 0.6 },
        {
          yPercent: 0,
          opacity: 1,
          ease: "none",
          scrollTrigger: {
            trigger: footer,
            start: "top 70%",
            end: "bottom bottom",
            scrub: true,
            onRefresh: () => ScrollTrigger.update(),
          },
        }
      );
    }

    // 4. Halftone Particle Reveal on Scroll (Full Viewport Trigger)
    if (footer) {
      const state = { progress: 0 };

      gsap.to(state, {
        progress: 1,
        ease: "none",
        scrollTrigger: {
          trigger: footer,
          start: "55% 50%",
          end: "90% 60%",
          scrub: 0.5,
          onUpdate: (self) => {
            window.dispatchEvent(
              new CustomEvent("update-halftone-progress", {
                detail: { progress: self.progress },
              })
            );
          },
        },
      });
    }

    // 5. Ultra-Smooth Low-Velocity Infinite Marquee
    if (marqueeTrack) {
      let currentX = 0;
      let baseSpeed = 0.8;
      let scrollVelocity = 0;
      let isHovered = false;

      marqueeTrack.addEventListener("mouseenter", () => { isHovered = true; });
      marqueeTrack.addEventListener("mouseleave", () => { isHovered = false; });

      ScrollTrigger.create({
        onUpdate: (self) => {
          scrollVelocity = self.getVelocity() * 0.008;
        },
      });

      gsap.ticker.add(() => {
        const halfWidth = marqueeTrack.offsetWidth / 2;
        if (!halfWidth) return;

        scrollVelocity *= 0.94;
        const speedMultiplier = isHovered ? 0 : baseSpeed;
        const delta = speedMultiplier + scrollVelocity;

        currentX -= delta;

        if (currentX <= -halfWidth) {
          currentX += halfWidth;
        } else if (currentX > 0) {
          currentX -= halfWidth;
        }

        gsap.set(marqueeTrack, { x: currentX });
      });
    }
  });
</script>
---
import GradientFill from '@components/GradientFill.jsx';
---

<!-- 1. Inline blocking check to prevent flash of preloader content on repeat visits -->
<script is:inline>
  (() => {
    try {
      if (sessionStorage.getItem("has_visited_preloader") === "true") {
        document.documentElement.classList.add("preloader-skipped");
      }
    } catch (e) {}
  })();
</script>

<style>
  :global(html.preloader-skipped) #preloader {
    display: none !important;
  }
</style>

<div id="preloader" class="preloader-overlay">
  <div class="preloader-center">
    <div id="logo-wrapper" class="logo-wrapper">
      <svg 
        viewBox="0 0 100 36" 
        class="outline-layer"
        xmlns="http://www.w3.org/2000/svg"
      >
        <text 
          x="50%" 
          y="50%" 
          dominant-baseline="central" 
          text-anchor="middle" 
          font-family="var(--font-montreal), system-ui, sans-serif" 
          font-weight="400" 
          font-size="24" 
          letter-spacing="1"
          fill="none" 
          stroke="var(--color-sanora-neutral-50)" 
          stroke-width="1" 
          opacity="0.25"
        >
          SNR
        </text>
      </svg>

      <div id="shader-mask-container" class="shader-mask-wrapper">
        <GradientFill client:only="react" />
      </div>
    </div>

    <div class="bottom-label">
      <div class="label-line split-words">Good experiences</div>
      <div class="label-line split-words">start with good thinking.</div>
    </div>
  </div>
</div>

<script>
  import { initPreloader } from "./preloader";

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initPreloader();
  } else {
    document.addEventListener("DOMContentLoaded", initPreloader, { once: true });
  }
</script>
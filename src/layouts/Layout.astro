---
// src/layouts/Layout.astro
import FloatingMenu from "@/components/ui/liquid-morph-floating-menu.tsx";
import Preloader from "../modules/transitions/preloader/Preloader.astro";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Sanora",
  description = "Sanora is my creative engineering practice, where frontend development, visual design, interaction, and motion come together.",
  image = "/og-image.png",
} = Astro.props;

// Absolute URLs required for social graph crawlers
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://sanora.dev");
const ogImageURL = new URL(image, Astro.site || "https://sanora.dev");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageURL} />
	</head>
	<body>
		<Preloader />
		<FloatingMenu client:load />
		<main id="main-content">
			<slot />
		</main>
		<script>
			import Lenis from "lenis";
			import { gsap } from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";
			import { ScrollToPlugin } from "gsap/ScrollToPlugin";

			gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

			// Initialize Lenis Smooth Scroll
			const lenis = new Lenis({
				duration: 1.2,
				easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Smooth exponential ease
				smoothWheel: true,
				wheelMultiplier: 1.0,
				touchMultiplier: 1.5,
			});

			// Synchronize Lenis scroll positions with GSAP ScrollTrigger
			lenis.on("scroll", ScrollTrigger.update);

			// Feed Lenis requestAnimationFrame time into GSAP Ticker
			gsap.ticker.add((time) => {
				lenis.raf(time * 1000);
			});

			// Disable GSAP lag smoothing to keep scroll animations fluid
			gsap.ticker.lagSmoothing(0);

			// Make lenis globally available
			(window as any).lenis = lenis;

			// Resync Lenis layout measurements when preloader animation finishes
			window.addEventListener("preloader-complete", () => {
				lenis.resize();
				ScrollTrigger.refresh();
			});

			// Setup Section Parallax Effect
			document.addEventListener("DOMContentLoaded", () => {
				const parallaxSections = document.querySelectorAll(".parallax-section");

				parallaxSections.forEach((section) => {
					const innerContent = section.querySelector(".parallax-inner") || section;
					
					gsap.fromTo(
						innerContent,
						{ y: -50 },
						{
							y: 50,
							ease: "none",
							scrollTrigger: {
								trigger: section,
								start: "top bottom",
								end: "bottom top",
								scrub: true,
							},
						}
					);
				});
			});
		</script>
	</body>
</html>

<style>
	html {
		/* Lenis required smooth scroll root styles */
		scroll-behavior: initial;
	}

	html.lenis,
	html.lenis body {
		height: auto;
	}

	.lenis.lenis-smooth {
		scroll-behavior: auto !important;
	}

	.lenis.lenis-smooth [data-lenis-prevent] {
		overscroll-behavior: contain;
	}

	.lenis.lenis-stopped {
		overflow: hidden;
	}

	.lenis.lenis-scrolling iframe {
		pointer-events: none;
	}
</style>